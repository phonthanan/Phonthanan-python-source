# รับชื่อจริง (หรือข้อความ) จากผู้ใช้
# นับจำนวนสระทั้งหมดในข้อควมนั้นว่ามีกี่ทำตัว (a, e, i, o ,u)

# ตัวอย่างหน้าจอ
# Whait is your name?:Boonchoo
# Your text have 4 vowels.

# input
Name = input("Enter your name: ")
letters = list(Name)

# process
a = letters.count('a')
e = letters.count('e')
i = letters.count('i')
o = letters.count('o')
u = letters.count('u')

A = letters.count('A')
E = letters.count('E')
I = letters.count('I')
O = letters.count('O')
U = letters.count('U')

count = a + e + i + o + u + A + E + I + O + U
# output
print("Your text have ", count, "vowels")